---
title: "Today's daily note on two Macs across midnight"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: Breaks DuplicateOnlyFromTwoPeople
    lg1: Breaks ClockNeverCreates or DuplicateOnlyFromTwoPeople in some cases
    lg2: Path to the ClockNeverCreates or DuplicateOnlyFromTwoPeople bug
    state "Terms" as terms {
      direction TB
      state " " as tc0 {
        direction LR
        tm0: person = The owner, at whichever Mac they are using.
        tm1: daily note = The vault file for today's date, shown in its own floating window.
        tm2: save timer = The pause after typing before the daily note is written.
        tm3: file watcher = The part of the app that notices the daily folder changed.
      }
      state " " as tc1 {
        direction LR
        tm4: numbered duplicate = '#60;date> 2.md', which iCloud makes when two Macs each create the same new file.
        tm5: outside edit = A change to the file from the other Mac or Obsidian.
        tm6: evicts = iCloud replaces the local file with a placeholder until it is read again.
        tm7: five-second retry = The reload the app schedules while it waits for a download.
      }
    }
  }
  class lg0 breaks
  class lg1 mayBreak
  class lg2 bugPath
  state "At the same time" as all {
    state "Mac A" as r0 {
      s0: Showing today's note (day 1)
      s1: Showing yesterday's note
      s2: Today's note open
      [*] --> s0
      s0 --> s1: the clock passes midnight
      s1 --> s2: the midnight timer or wake switches to today
    }
    --
    state "Mac B" as r1 {
      s3: Showing today's note (day 1)
      s4: Showing yesterday's note
      s5: Today's note open
      [*] --> s3
      s3 --> s4: the clock passes midnight
      s4 --> s5: the midnight timer or wake switches to today [when Mac A is Today's note open]
    }
    --
    state "iCloud" as r2 {
      s6: Day 1, no day-2 file
      s7: No file for today in iCloud
      s8: One file for today in iCloud
      s9: Today's file plus a numbered duplicate
      [*] --> s6
      s6 --> s7: the clock passes midnight
      s7 --> s8: iCloud uploads the local change [when Mac A is Today's note open and Mac B is Today's note open]
      s8 --> s9: iCloud uploads the local change
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 bugPath
  class s1 bugPath
  class s2 mayBreak
  class s2 bugPath
  class s3 bugPath
  class s4 mayBreak
  class s4 bugPath
  class s5 bugPath
  class s6 bugPath
  class s7 mayBreak
  class s7 bugPath
  class s8 bugPath
  class s9 breaks
  class s9 bugPath
