---
title: "One sticky note: typing, saving, outside edits, conflict versions, archive and Trash"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: editing
    lg1: syncing
    lg2: stored
    lg3: Breaks CloseAlwaysWorks
    lg4: Breaks CloseAlwaysWorks or TypedTextKept in some cases
    lg5: Path to the CloseAlwaysWorks or TypedTextKept bug
    state "Terms" as terms {
      direction TB
      state " " as tc0 {
        direction LR
        tm0: person = The owner, using Sticky Notes on this Mac.
        tm1: save timer = The half-second pause after typing before the note is written to its file.
        tm2: file watcher = The part of the app that notices the note's file changed on disk.
        tm3: desk = The app part that keeps one window per active note.
      }
      state " " as tc1 {
        direction LR
        tm4: outside edit = A change to the note's file made by Obsidian, the other Mac or iCloud.
        tm5: conflict version = A second copy of the file that iCloud keeps when two saves disagree.
        tm6: conflict sweep = The app step that merges conflict versions back into the file.
        tm7: other Mac = The owner's second Mac, used in turn, not at the same time.
      }
      state " " as tc2 {
        direction LR
        tm8: Obsidian = The notes app that shares the vault folder.
        tm9: iCloud = iCloud Drive, which syncs the vault between the Macs.
        tm10: placeholder = A hidden stand-in file iCloud leaves for a file it has not downloaded.
        tm11: archive = Closed notes, still listed in the notes panel.
      }
      state " " as tc3 {
        direction LR
        tm12: Trash = Notes deleted from the archive, kept 30 days.
      }
    }
  }
  class lg0 blue
  class lg1 orange
  class lg2 teal
  class lg3 breaks
  class lg4 mayBreak
  class lg5 bugPath
  s0: New note, no file yet
  s1: App quit, note on disk
  s2: No note file, window closed
  s3: File changed, window not told yet
  s4: Note in the archive, window closed
  s5: Typing, save pending
  s6: Note open, nothing pending
  s7: Save pending, person in another window
  s8: Typing, save pending, caret out of the text
  [*] --> s0
  s0 --> s1: the person quits the app
  s0 --> s2: the person clicks the note's close button or the person switches to another window
  s0 --> s0: the person types in the note
  s2 --> s1: the person quits the app
  s0 --> s3: the half-second save timer writes the note
  s3 --> s1: the person quits the app
  s3 --> s4: the person clicks the note's close button
  s3 --> s5: the person types in the note
  s3 --> s6: the file watcher reports the change to the window [the window shows it]
  s4 --> s1: the person quits the app
  s5 --> s1: the person quits the app
  s5 --> s4: the person clicks the note's close button
  s5 --> s3: the half-second save timer writes the note
  s5 --> s7: the person switches to another window
  s5 --> s8: the person grabs the note's title bar
  s6 --> s1: the person quits the app
  s6 --> s4: the person clicks the note's close button
  s6 --> s5: the person types in the note
  s7 --> s5: the person clicks into the text
  s7 --> s1: the person quits the app
  s7 --> s4: the person clicks the note's close button
  s7 --> s3: the half-second save timer writes the note
  s8 --> s5: the person clicks into the text
  s8 --> s1: the person quits the app
  s8 --> s4: the person clicks the note's close button
  s8 --> s7: the person switches to another window
  s8 --> s3: the half-second save timer writes the note
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 teal
  class s0 mayBreak
  class s0 bugPath
  class s1 teal
  class s1 mayBreak
  class s2 teal
  class s2 mayBreak
  class s2 bugPath
  class s3 orange
  class s4 teal
  class s4 mayBreak
  class s5 breaks
  class s6 blue
  class s7 breaks
  class s8 breaks
