---
title: "One sticky note: typing, saving, outside edits, archive and Trash"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: syncing
    lg1: stored
    lg2: Breaks TypedTextKept
    lg3: Breaks NoSpuriousConflictBlock or WindowMatchesDisk in some cases
    lg4: Path to the NoSpuriousConflictBlock or TypedTextKept or WindowMatchesDisk bug
    state "Terms" as terms {
      direction TB
      state " " as tc0 {
        direction LR
        tm0: person = The owner, using Sticky Notes on this Mac.
        tm1: save timer = The half-second pause after typing before the note is written to its file.
        tm2: file watcher = The part of the app that notices the note's file changed on disk.
        tm3: outside edit = A change to the note's file made by Obsidian, the other Mac or iCloud.
      }
      state " " as tc1 {
        direction LR
        tm4: conflict version = A second copy of the file that iCloud keeps when two saves disagree.
        tm5: conflict sweep = The app step that merges conflict versions back into the file and appends a 'Conflicted copy' section.
        tm6: other Mac = The owner's second Mac, running Sticky Notes on the same vault.
        tm7: Obsidian = The notes app that shares the vault folder.
      }
      state " " as tc2 {
        direction LR
        tm8: iCloud = iCloud Drive, which syncs the vault between the Macs.
        tm9: archive = Closed notes, still listed in the notes panel.
        tm10: Trash = Notes deleted from the archive, kept 30 days.
      }
    }
  }
  class lg0 orange
  class lg1 teal
  class lg2 breaks
  class lg3 mayBreak
  class lg4 bugPath
  s0: File changed, window not told yet
  s1: Typing, save pending
  s2: Other Mac's conflict version waiting
  s3: Note file deleted
  s4: Outside edit held back
  s5: Save pending, person in another window
  s6: Older own save kept as a conflict version
  [*] --> s0
  s0 --> s1: the person types in the note
  s0 --> s2: the other Mac's edit arrives as a conflict version
  s1 --> s0: the half-second save timer writes the note
  s2 --> s3: the person leaves an empty note by closing it or switching away
  s2 --> s4: the conflict sweep merges the conflict version [the window holds it back]
  s1 --> s5: the person switches to another window
  s5 --> s0: the half-second save timer writes the note
  s0 --> s6: iCloud keeps an older save as a conflict version
  s6 --> s0: the conflict sweep merges the conflict version [the window shows it]
  s4 --> s4: the file watcher reports the change [it replaces the held-back edit]
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,stroke-width:2.5px,color:#b85a06
  class s0 orange
  class s0 bugPath
  class s1 orange
  class s1 bugPath
  class s2 orange
  class s2 bugPath
  class s3 teal
  class s3 breaks
  class s3 bugPath
  class s4 orange
  class s4 mayBreak
  class s4 bugPath
  class s5 orange
  class s5 bugPath
  class s6 orange
  class s6 bugPath
